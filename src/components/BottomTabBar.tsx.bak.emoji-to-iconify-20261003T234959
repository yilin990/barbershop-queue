'use client'

import { usePathname, useRouter } from 'next/navigation'

const TABS = [
  {
    key: 'merchant',
    label: '商户',
    icon: '🏠',
    iconActive: '🏠',
    path: '/merchant',
  },
  {
    key: 'community',
    label: '故事',
    icon: '✨',
    iconActive: '✨',
    path: '/community',
  },
  {
    key: 'ai-find-drug',
    label: '造型 AI',
    icon: '🤖',
    iconActive: '🤖',
    path: '/ai-find-drug',
  },
  {
    key: 'pharmacist',
    label: '风格库',
    icon: '🍵',
    iconActive: '🍵',
    path: '/pharmacist',
  },
  {
    key: 'orders',
    label: '订单',
    icon: '📋',
    iconActive: '📋',
    path: '/orders',
  },
  {
    key: 'me',
    label: '我的',
    icon: '✂️',
    iconActive: '✂️',
    path: '/me',
  },
]

export default function BottomTabBar() {
  const pathname = usePathname()

  const isActive = (path: string) => {
    if (path === '/merchant') {
      return pathname === '/' || pathname === '/merchant'
    }
    return pathname === path || pathname.startsWith(path + '/')
  }

  const router = useRouter()

  const handleTabClick = (path: string) => {
    router.push(path)
  }

  return (
    <>
      {/* Tab spacer - prevents content from being hidden behind tab bar */}
      {/* ⭐ 奕霖 2026-07-16 01:18：包含 safe-area，刘海屏不会遮挡底部按钮 */}
      {/* ⭐ 奕霖 2026-08-05 01:11：响应式 — clamp 让小屏自动缩字号 + icon */}
      <div
        style={{
          height: 'calc(72px + env(safe-area-inset-bottom, 0px))',
          fontSize: 'clamp(9px, 2.5vw, 11px)',
        }}
      />

      {/* Fixed Bottom Tab Bar */}
      <div
        style={{
          position: 'fixed',
          bottom: 0,
          left: 0,
          right: 0,
          zIndex: 100,
          background: 'linear-gradient(180deg, rgba(250, 246, 240, 0.92) 0%, rgba(255, 250, 240, 0.98) 100%)',
          backdropFilter: 'blur(24px)',
          WebkitBackdropFilter: 'blur(24px)',
          borderTop: '1px solid rgba(184, 134, 11, 0.28)',
          borderTopLeftRadius: '24px',
          borderTopRightRadius: '24px',
          boxShadow: '0 -8px 32px rgba(44, 24, 16, 0.12), inset 0 1px 0 rgba(184, 134, 11, 0.08)',
          paddingBottom: 'env(safe-area-inset-bottom, 12px)',
        }}
      >
       <div
          style={{
            display: 'grid',
            gridTemplateColumns: 'repeat(6, 1fr)',
            maxWidth: '480px',
            margin: '0 auto',
            padding: '8px 8px 12px',
            gap: '1px',
          }}
        >
          {TABS.map((tab) => {
            const active = isActive(tab.path)
            return (
              <button
                key={tab.key}
                onClick={() => handleTabClick(tab.path)}
                style={{
                  display: 'flex',
                  flexDirection: 'column',
                  alignItems: 'center',
                  justifyContent: 'center',
                  gap: '3px',
                  padding: '6px clamp(2px, 1vw, 6px)',
                  borderRadius: '16px',
                  border: 'none',
                  background: active
                    ? 'linear-gradient(135deg, rgba(184, 134, 11, 0.18) 0%, rgba(184, 134, 11, 0.08) 100%)'
                    : 'transparent',
                  cursor: 'pointer',
                  transition: 'all 0.2s ease',
                  boxShadow: active
                    ? 'inset 0 1px 0 rgba(184, 134, 11, 0.15), 0 2px 8px rgba(184, 134, 11, 0.18)'
                    : 'none',
                }}
              >
               <div
                  style={{
                    fontSize: 'clamp(18px, 5vw, 22px)',
                    filter: active
                      ? 'drop-shadow(0 2px 8px rgba(184, 134, 11, 0.5))'
                      : 'grayscale(0.3)',
                    transition: 'all 0.2s ease',
                    transform: active ? 'scale(1.1)' : 'scale(1)',
                  }}
                >
                  {active ? tab.iconActive : tab.icon}
                </div>
                <span
                  style={{
                    fontSize: '10px',
                    fontWeight: active ? 700 : 500,
                    color: active ? '#b8860b' : '#5d4037',
                    letterSpacing: active ? '0.5px' : '0.3px',
                    transition: 'all 0.2s ease',
                    textShadow: active
                      ? '0 0 12px rgba(184, 134, 11, 0.4)'
                      : 'none',
                  }}
                >
                  {tab.label}
                </span>
                {/* Active indicator dot */}
                {active && (
                  <div
                    style={{
                      width: '4px',
                      height: '4px',
                      borderRadius: '50%',
                      background: '#b8860b',
                      boxShadow: '0 0 6px rgba(184, 134, 11, 0.8)',
                      marginTop: '1px',
                    }}
                  />
                )}
              </button>
            )
          })}
        </div>
      </div>
    </>
  )
}