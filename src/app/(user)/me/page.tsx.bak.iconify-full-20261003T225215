/** 购物车入口卡片（从 localStorage 读数量） */
function CartEntryCard() {
  const router = useRouter()
  const [count, setCount] = useState(0)
  useEffect(() => {
    const update = () => {
      try {
        const cart = JSON.parse(localStorage.getItem('cart') || '[]')
        const total = cart.reduce((sum: number, it: any) => sum + (it.quantity || 1), 0)
        setCount(total)
      } catch { setCount(0) }
    }
    update()
    window.addEventListener('storage', update)
    const t = setInterval(update, 2000)
    return () => { window.removeEventListener('storage', update); clearInterval(t) }
  }, [])
  return (
    <button
      onClick={() => router.push('/cart')}
      style={{
        padding: '14px 16px', borderRadius: '14px', cursor: 'pointer', textAlign: 'left',
        background: 'linear-gradient(135deg, rgba(184, 134, 11, 0.12) 0%, rgba(184, 134, 11, 0.15) 100%)',
        border: '1px solid rgba(184, 134, 11, 0.3)',
        display: 'flex', alignItems: 'center', gap: '12px',
      }}
    >
      <div style={{ fontSize: '24px' }}><Icon icon="material-symbols:shopping-cart" width="24" style={{ display: 'inline-block', verticalAlign: 'middle', fontVariationSettings: "'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 48", color: '#b8801f' }} /></div>
      <div style={{ flex: 1 }}>
        <div style={{ fontSize: '13px', fontWeight: 700, color: '#b8860b', marginBottom: '2px' }}>我的购物车</div>
        <div style={{ fontSize: '11px', color: 'rgba(255,255,255,0.5)' }}>{count > 0 ? `${count} 件商品` : '空空如也'}</div>
      </div>
      <div style={{ fontSize: '20px', color: 'rgba(255,255,255,0.3)' }}>→</div>
    </button>
  )
}

