  id: string
  customerName: string
  customerPhone: string
  service: '剪发' | '烫发' | '染发' | '护理'
  stylistName: string
  status: OrderStatus
  scheduledAt: string
  scheduledDate: 'today' | 'tomorrow' | 'dayAfter'
  arrivedAt?: string
  startedAt?: string
  completedAt?: string
  note?: string
}

