// speech.ts - Web Speech API 封装 + TTS 音频队列管理（支持流式打断）

import { Message } from '@/domain/chat/service'

// ---------------------------------------------------------------------------
// 类型定义
// ---------------------------------------------------------------------------
export interface SpeechRecognitionResult {
  transcript: string
  isFinal: boolean
}

export type SpeechCallback = (result: SpeechRecognitionResult) => void
export type ErrorCallback = (error: string) => void

// ---------------------------------------------------------------------------
// TTS 内存缓存（奕霖 2026-06-30 18:28 反馈语音生成慢）
// 同一文本不重复生成，LRU 100 条上限
// ---------------------------------------------------------------------------
const TTS_CACHE_MAX = 100
const ttsCache = new Map<string, string>()

function hashText(text: string): string {
  let h = 0
  for (let i = 0; i < text.length; i++) {
    h = ((h << 5) - h) + text.charCodeAt(i)
    h |= 0
  }
  return h.toString(36) + '_' + text.length
}

function getCachedAudio(text: string): string | null {
  const key = hashText(text)
  const url = ttsCache.get(key)
  if (url) {
    ttsCache.delete(key)
    ttsCache.set(key, url)
    return url
  }
  return null
}

function setCachedAudio(text: string, url: string): void {
  const key = hashText(text)
  if (ttsCache.has(key)) ttsCache.delete(key)
  ttsCache.set(key, url)
  if (ttsCache.size > TTS_CACHE_MAX) {
    const firstKey = ttsCache.keys().next().value
    if (firstKey) {
      const oldUrl = ttsCache.get(firstKey)
      if (oldUrl) URL.revokeObjectURL(oldUrl)
      ttsCache.delete(firstKey)
    }
  }
}

