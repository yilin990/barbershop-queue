/**
 * 芝林大药房 Service Worker
 * ⭐ 2026-08-26 00:05:版本升 v2.0.0 触发自动清旧 v1 缓存
 * 用户报'打不开'可能是浏览器加载了 v1 缓存的旧 chat-page JS chunk
 * 这次升级让浏览器下次访问自动清掉所有 zhilin-cache-v5.0.0 缓存
 */
/**
 * 芝林大药房 Service Worker
 * 策略：network-first 走 API，cache-first 走静态资源
 */

const CACHE_NAME = 'zhilin-v4.0.0';  // ⭐ 2026-08-28 19:11:再升一级强制清浏览器缓存(/search 持续报没数据,推测浏览器还没彻底清旧)
const STATIC_CACHE = 'zhilin-cache-v5.0.0';  // ⭐ 同步升 v3  // ⭐ 2026-08-26 00:05 升级 v2.0.0:触发用户浏览器清旧 v1 缓存,避免之前'打不开'残留
const RUNTIME_CACHE = 'zhilin-cache-v5.0.0';  // ⭐ 同步升 v3  // ⭐ 2026-08-26 00:05 同上

// 预缓存关键资源
const PRECACHE_URLS = [
  '/',
  '/merchant',
  '/pharmacist',
  '/manifest.json',
  '/icon-192.png',
  '/icon-512.png',
  '/apple-touch-icon.png',
  '/merchant-logo.png',
];

// 安装
self.addEventListener('install', (event) => {
  event.waitUntil(
    caches.open(STATIC_CACHE).then((cache) => {
      return cache.addAll(PRECACHE_URLS).catch((err) => {
        console.warn('[SW] precache failed:', err);
      });
    }).then(() => self.skipWaiting())
  );
});

// 激活
self.addEventListener('activate', (event) => {
  event.waitUntil(
    caches.keys().then((cacheNames) => {
      return Promise.all(
        cacheNames
          .filter((name) => name !== STATIC_CACHE && name !== RUNTIME_CACHE)
          .map((name) => caches.delete(name))
      );
    }).then(() => self.clients.claim())
  );
});

// fetch 拦截
self.addEventListener('fetch', (event) => {
  const { request } = event;
  const url = new URL(request.url);

  // 只处理 GET
  if (request.method !== 'GET') return;

  // 跳过跨域
  if (url.origin !== location.origin) return;

  // API 请求：network-first（保证实时数据）
  if (url.pathname.startsWith('/api/')) {
    event.respondWith(networkFirst(request));
    return;
  }

  // 静态资源：cache-first（速度快）
  if (
    url.pathname.match(/\.(js|css|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|eot)$/) ||
    url.pathname.startsWith('/_next/static/')
  ) {
    event.respondWith(cacheFirst(request));
    return;
  }

  // 页面：network-first，离线时回退到缓存的 /
  event.respondWith(networkFirstWithFallback(request));
});

// network-first 策略（API 用）
async function networkFirst(request) {
  try {
    const response = await fetch(request);
    if (response && response.status === 200) {
      const cache = await caches.open(RUNTIME_CACHE);
      cache.put(request, response.clone());
    }
    return response;
  } catch (err) {
    const cached = await caches.match(request);
    if (cached) return cached;
    return new Response(JSON.stringify({ error: 'offline', cached: false }), {
      status: 503,
      headers: { 'Content-Type': 'application/json' },
    });
  }
}

// cache-first 策略（静态资源用）
async function cacheFirst(request) {
  const cached = await caches.match(request);
  if (cached) return cached;
  try {
    const response = await fetch(request);
    if (response && response.status === 200) {
      const cache = await caches.open(RUNTIME_CACHE);
      cache.put(request, response.clone());
    }
    return response;
  } catch (err) {
    return new Response('', { status: 504 });
  }
}

// network-first 页面（离线回退 /）
async function networkFirstWithFallback(request) {
  try {
    const response = await fetch(request);
    if (response && response.status === 200) {
      const cache = await caches.open(RUNTIME_CACHE);
      cache.put(request, response.clone());
    }
    return response;
  } catch (err) {
    const cached = await caches.match(request);
    if (cached) return cached;
    const root = await caches.match('/');
    if (root) return root;
    return new Response('Offline', { status: 503 });
  }
}